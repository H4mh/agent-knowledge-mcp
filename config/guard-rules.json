{
  "hardReject": [
    { "name": "私钥块", "pattern": "-----BEGIN (RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----" },
    { "name": "AWS密钥", "pattern": "AKIA[0-9A-Z]{16}" },
    { "name": "JWT令牌", "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}" },
    { "name": "连接串带密码", "pattern": "(jdbc|postgres(?:ql)?|mysql)://[^\\s'\"<>]+:[^@\\s'\"<>]+@" },
    { "name": "身份证号", "pattern": "\\b[1-9]\\d{5}(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[0-9Xx]\\b" },
    { "name": "银行卡号", "pattern": "\\b\\d{16,19}\\b" }
  ],
  "warnOnly": [
    { "name": "内网IP", "pattern": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})\\b" },
    { "name": "内网主机名", "pattern": "\\b[a-z0-9-]+\\.(?:local|internal|corp)\\b" }
  ]
}
